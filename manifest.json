{
  "manifest_version": 3,
  "name": "Shut Up YouTube",
  "version": "2.0.0",
  "description": "Filter YouTube ads, hide Shorts and AI-labeled videos, confirm content warnings, hide Playables, and customize video fit and logo.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["settings.js", "logo.js", "warnings.js", "filters.js", "activity.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/stfu-16.png",
      "32": "icons/stfu-32.png",
      "48": "icons/stfu-48.png",
      "128": "icons/stfu-128.png"
    }
  },
  "icons": {
    "16": "icons/stfu-16.png",
    "32": "icons/stfu-32.png",
    "48": "icons/stfu-48.png",
    "128": "icons/stfu-128.png"
  }
}
